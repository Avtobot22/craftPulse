
{
  "tls_dir": "/etc/craftpulse/tls",
  "check_profiles": "/etc/craftpulse/check-profiles.yaml",
  "backup_recipient": "<public age recipient>",
  "installation_networks": "172.31.84.0/27",
  "source_private_networks": "",
  "required_adapters": ["jiracloud"],
  "adapter_master_key_versions": {"jiracloud": 1},
  "install": {
    "INSTALL_ORGANIZATIONS": "org-a,org-b",
    "ORG_ORG_A_NAME": "Организация A",
    "ORG_ORG_A_OIDC_ISSUER": "https://gitlab.defects.team",
    "ORG_ORG_A_OIDC_CLIENT_ID": "<application_id for craftpulse-org-a>",
    "ORG_ORG_A_ADMIN_SUBJECT": "<OIDC sub for cp87-admin-a>",
    "ORG_ORG_B_NAME": "Организация B",
    "ORG_ORG_B_OIDC_ISSUER": "https://gitlab.defects.team",
    "ORG_ORG_B_OIDC_CLIENT_ID": "<application_id for craftpulse-org-b>",
    "ORG_ORG_B_ADMIN_SUBJECT": "<OIDC sub for cp87-admin-b>"
  }
}
