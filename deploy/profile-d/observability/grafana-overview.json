{
  "uid": "craftpulse-overview",
  "title": "craftPulse",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Доступность API и worker",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "craftpulse-metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"craftpulse\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Память Go",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "craftpulse-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_memstats_heap_alloc_bytes{job=\"craftpulse\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ]
