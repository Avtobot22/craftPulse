map $uri $limit_by_ip {
    default "";
    ~^/(api/v1/)?o/[^/]+/(login|callback)$ $binary_remote_addr;
    ~^/api/v1/webhooks(/|$) $binary_remote_addr;
    /source-links/callback $binary_remote_addr;
}

limit_req_zone $limit_by_ip zone=sensitive_routes:1m rate=5r/s;

upstream craftpulse_api {
    zone craftpulse_api 64k;
    resolver 127.0.0.11 valid=5s ipv6=off;
    server api:8080 resolve;
    keepalive 8;
}

server {
    listen 8080;
    return 308 ${CRAFTPULSE_SITE_URL}$request_uri;
}

server {
    listen 8443 ssl;
    ssl_certificate /run/secrets/tls-cert.pem;
    ssl_certificate_key /run/secrets/tls-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    set_real_ip_from ${CRAFTPULSE_EDGE_PROXY_IP};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    root /usr/share/nginx/html;
    client_max_body_size 25m;
    client_body_timeout 20s;
    send_timeout 30s;
    limit_req zone=sensitive_routes burst=5 nodelay;
    limit_req_status 429;

    location ~ ^(/api/v1/|/o/[^/]+/(login|callback)$|/source-links/callback$|/(readyz|livez|version)$) {
        proxy_pass http://craftpulse_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_send_timeout 30s;
        proxy_read_timeout 60s;
        proxy_next_upstream error timeout http_503;
        proxy_next_upstream_tries 2;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
