{
    log default {
        format filter {
            wrap json
            fields {
                request>uri query {
                    delete code
                    delete state
                }
            }
        }
    }
}

craftpulse.defects.team {
    @atlassian path /source-links/callback /atlassian-check/ /atlassian-check/start
    log_skip @atlassian
    handle @atlassian {
        reverse_proxy 127.0.0.1:8092
    }
    handle {
        reverse_proxy 127.0.0.1:8090
    }
}
