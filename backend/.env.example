# api and worker; *_FILE holds the path to a secret file.
LOG_LEVEL=info
HTTP_ADDR=:8080
METRICS_ADDR=:9090
DATABASE_URL=postgres://craftpulse_app@postgres:5432/craftpulse?sslmode=disable
DATABASE_PASSWORD_FILE=/run/secrets/craftpulse_app_password
DATABASE_MAX_CONNS=10
OBJECT_STORE_ENDPOINT=http://seaweedfs:8333
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET=craftpulse
OBJECT_STORE_ACCESS_KEY_ID=craftpulse
OBJECT_STORE_SECRET_ACCESS_KEY_FILE=/run/secrets/object_store_secret_key
# Core master key: a file with base64 of 32 bytes. The previous key is set only during rotation.
CORE_MASTER_KEY_VERSION=1
CORE_MASTER_KEY_FILE=/run/secrets/core_master_key_v1
CORE_PREVIOUS_MASTER_KEY_VERSION=
CORE_PREVIOUS_MASTER_KEY_FILE=

# api and api install: the origin of the site, without a path.
SITE_URL=https://craftpulse.example

# api install only. ORG_<SLUG>_* is set for every slug, upper case with dashes as underscores.
INSTALL_ORGANIZATIONS=demo,second-org
RUNNER_NETWORK=10.20.0.0/16
RELEASE_IMAGES=craftpulse-server=sha256:...,frontend=sha256:...
ORG_DEMO_NAME=Demo
ORG_DEMO_OIDC_ISSUER=https://gitlab.example
ORG_DEMO_OIDC_CLIENT_ID=
ORG_DEMO_OIDC_CLIENT_SECRET_FILE=/run/secrets/demo_oidc_client_secret
ORG_DEMO_ADMIN_SUBJECT=
