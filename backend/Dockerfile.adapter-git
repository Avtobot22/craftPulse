# syntax=docker/dockerfile:1

FROM golang:1.27.4-alpine@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS build

ENV CGO_ENABLED=0 GOFLAGS=-trimpath GOTOOLCHAIN=local
WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . ./

ARG COMMIT_SHA=unknown
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -buildvcs=false \
      -ldflags="-s -w -X github.com/Avtobot22/craftPulse/backend/pkg/health._commitSHA=${COMMIT_SHA}" \
      -o /out/ ./cmd/adapter-git

# git and ssh are pinned: the adapter runs them on repositories of clients (TZ 11).
FROM alpine:3.22@sha256:49340b346798875b5592e5d420241f2f9cfba5f47e62ebb1446a1b34734e898f

RUN apk add --no-cache git=2.49.1-r0 openssh-client-default=10.0_p1-r11 ca-certificates=20261020-r0 \
    && addgroup -S -g 65532 adapter && adduser -S -D -H -u 65532 -G adapter adapter \
    && install -d -o 65532 -g 65532 -m 0700 /var/cache/craftpulse-git

ARG COMMIT_SHA=unknown
LABEL org.opencontainers.image.title="craftpulse-adapter-git" \
      org.opencontainers.image.revision="${COMMIT_SHA}" \
      org.opencontainers.image.source="https://github.com/Avtobot22/craftPulse"

COPY --from=build /out/adapter-git /usr/local/bin/

USER 65532:65532
ENV GIT_CACHE_DIR=/var/cache/craftpulse-git
EXPOSE 8443
ENTRYPOINT ["/usr/local/bin/adapter-git"]
