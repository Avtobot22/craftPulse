{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "craftPulse MR and CI model v1",
  "$ref": "#/$defs/ChangeFile",
  "$defs": {
    "ChangeFile": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "period": {
          "$ref": "#/$defs/Window"
        },
        "as_of": {
          "type": "string"
        },
        "merge_requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MergeRequest"
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CIRun"
          }
        },
        "branches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CIBranch"
          }
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VariantObjects"
          }
        }
      },
      "required": [
        "schema_version",
        "seed",
        "period",
        "as_of",
        "merge_requests",
        "runs",
        "branches",
        "variants"
      ],
      "additionalProperties": false
    },
    "Window": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "MergeRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "organization_id": {
          "type": "string"
        },
        "instance_id": {
          "type": "string"
        },
        "repository_id": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "author_id": {
          "type": "string"
        },
        "initial_state": {
          "type": "string"
        },
        "final_state": {
          "type": "string"
        },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MREvent"
          }
        },
        "task_links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MRTaskLink"
          }
        }
      },
      "required": [
        "id",
        "organization_id",
        "instance_id",
        "repository_id",
        "branch",
        "head",
        "title",
        "author_id",
        "initial_state",
        "final_state",
        "reviewers",
        "events",
        "task_links"
      ],
      "additionalProperties": false
    },
    "MREvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "actor_id": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "actor_id",
        "body"
      ],
      "additionalProperties": false
    },
    "MRTaskLink": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "task_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "key",
        "task_ids"
      ],
      "additionalProperties": false
    },
    "CIRun": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "organization_id": {
          "type": "string"
        },
        "instance_id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "repository_id": {
          "type": "string"
        },
        "merge_request_id": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "sha": {
          "type": "string"
        },
        "initial_status": {
          "type": "string"
        },
        "final_status": {
          "type": "string"
        },
        "execution_manifest": {
          "type": "boolean"
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CIJob"
          }
        }
      },
      "required": [
        "id",
        "organization_id",
        "instance_id",
        "provider",
        "repository_id",
        "merge_request_id",
        "branch",
        "sha",
        "initial_status",
        "final_status",
        "execution_manifest",
        "jobs"
      ],
      "additionalProperties": false
    },
    "CIJob": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "axes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "configuration_hash": {
          "type": "string"
        },
        "allow_failure": {
          "type": "boolean"
        },
        "initial_status": {
          "type": "string"
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CIAttempt"
          }
        }
      },
      "required": [
        "id",
        "name",
        "stage",
        "axes",
        "configuration_hash",
        "allow_failure",
        "initial_status",
        "attempts"
      ],
      "additionalProperties": false
    },
    "CIAttempt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "type": "string"
        },
        "reports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CIReport"
          }
        }
      },
      "required": [
        "id",
        "number",
        "outcome",
        "reports"
      ],
      "additionalProperties": false
    },
    "CIReport": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "sha": {
          "type": "string"
        },
        "test_case_id": {
          "type": "string"
        },
        "covered_lines": {
          "type": "integer",
          "minimum": 0
        },
        "total_lines": {
          "type": "integer",
          "minimum": 0
        },
        "covered_branches": {
          "type": "integer",
          "minimum": 0
        },
        "total_branches": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "path",
        "format",
        "sha",
        "test_case_id",
        "covered_lines",
        "total_lines",
        "covered_branches",
        "total_branches"
      ],
      "additionalProperties": false
    },
    "CIBranch": {
      "type": "object",
      "properties": {
        "repository_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "commit": {
          "$ref": "#/$defs/Commit"
        },
        "definition_path": {
          "type": "string"
        },
        "definition_sha256": {
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "name",
        "commit",
        "definition_path",
        "definition_sha256"
      ],
      "additionalProperties": false
    },
    "Commit": {
      "type": "object",
      "properties": {
        "sha": {
          "type": "string"
        },
        "tree": {
          "type": "string"
        },
        "parents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "author_id": {
          "type": "string"
        },
        "author_time": {
          "$ref": "#/$defs/SourceTime"
        },
        "committer_id": {
          "type": "string"
        },
        "commit_time": {
          "$ref": "#/$defs/SourceTime"
        },
        "message": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "sha",
        "tree",
        "parents",
        "author_id",
        "author_time",
        "committer_id",
        "commit_time",
        "message",
        "files"
      ],
      "additionalProperties": false
    },
    "SourceTime": {
      "type": "object",
      "properties": {
        "utc": {
          "type": "string"
        },
        "original_offset": {
          "type": "string"
        }
      },
      "required": [
        "utc",
        "original_offset"
      ],
      "additionalProperties": false
    },
    "VariantObjects": {
      "type": "object",
      "properties": {
        "variant_id": {
          "type": "string"
        },
        "object_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "variant_id",
        "object_ids"
      ],
      "additionalProperties": false
    }
  }
}
