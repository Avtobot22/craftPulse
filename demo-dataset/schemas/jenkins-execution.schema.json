{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "craftPulse Jenkins execution manifest v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "dataset_run_id": {
      "type": "string",
      "minLength": 1
    },
    "job": {
      "type": "string",
      "minLength": 1
    },
    "build_number": {
      "type": "integer",
      "minimum": 1
    },
    "build_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "dataset_attempt_id": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "axes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "configuration_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "outcome": {
            "enum": [
              "success",
              "failure",
              "timeout",
              "canceled"
            ]
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "agent_label": {
            "type": "string",
            "minLength": 1
          },
          "reports": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "format": {
                  "enum": [
                    "junit",
                    "cobertura"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "source_sha": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                }
              },
              "required": [
                "path",
                "format",
                "sha256",
                "source_sha"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "dataset_attempt_id",
          "stage",
          "name",
          "axes",
          "configuration_hash",
          "attempt",
          "outcome",
          "started_at",
          "finished_at",
          "agent_label",
          "reports"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "dataset_run_id",
    "job",
    "build_number",
    "build_url",
    "sha",
    "steps"
  ],
  "additionalProperties": false
}
